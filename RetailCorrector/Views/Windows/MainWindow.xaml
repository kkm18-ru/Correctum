<Window x:Class="RetailCorrector.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:control="clr-namespace:RetailCorrector.UI.Controls"
        xmlns:controlMVVM="clr-namespace:RetailCorrector.Views.Controls"
        xmlns:vm="clr-namespace:RetailCorrector.ViewModels"
        Title="Correctum" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Command="{Binding PasteCommand}" Key="V" Modifiers="Ctrl"/>
    </Window.InputBindings>
    <DockPanel>
        <control:MainMenu DockPanel.Dock="Top"/>
        <WrapPanel DockPanel.Dock="Top">
                                        
        </WrapPanel>
        <controlMVVM:ReceiptGrid/>
    </DockPanel>
</Window>
