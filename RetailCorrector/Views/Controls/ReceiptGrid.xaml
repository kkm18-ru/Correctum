<DockPanel x:Class="RetailCorrector.Views.Controls.ReceiptGrid"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
           xmlns:local="clr-namespace:RetailCorrector.Views.Controls"           
           xmlns:utils="clr-namespace:RetailCorrector.Utils"
           xmlns:vm="clr-namespace:RetailCorrector.ViewModels"
           xmlns:root="clr-namespace:RetailCorrector">
    <DockPanel.DataContext>
        <vm:ReceiptGridViewModel/>
    </DockPanel.DataContext>
    <WrapPanel DockPanel.Dock="Top" Height="35" ItemHeight="25">
        <Button Content="&#8635;" Margin="5,5,-5,-5" Width="30" FontWeight="Black" 
                VerticalContentAlignment="Center" FontSize="13" Command="{Binding RefreshCommand}" />
        <Button Content="&lt;&lt;" Margin="15,5,-15,-5" Width="30" FontWeight="Black" 
                VerticalContentAlignment="Center" FontSize="13" Command="{Binding FirstPageCommand}" />
        <Button Content="&lt;" Margin="20,5,-20,-5" Width="30" FontWeight="Black" 
                VerticalContentAlignment="Center" FontSize="13" Command="{Binding PrevPageCommand}" />
        <tk:UIntegerUpDown Margin="25,5,-25,-5" Width="100" VerticalContentAlignment="Center" 
                           Value="{Binding CurrentPage}" ShowButtonSpinner="False" />
        <Button Content="&gt;" Margin="30,5,-30,-5" Width="30" FontWeight="Black" 
                VerticalContentAlignment="Center" FontSize="13" Command="{Binding NextPageCommand}" />
        <Button Content="&gt;&gt;" Margin="35,5,-35,-5" Width="30" FontWeight="Black" 
                VerticalContentAlignment="Center" FontSize="13" Command="{Binding LastPageCommand}" />
    </WrapPanel>
    <DataGrid ItemsSource="{x:Static root:Storage.ReceiptView}"
              CanUserDeleteRows="false" CanUserSortColumns="false" 
              CanUserReorderColumns="false" CanUserResizeColumns="false" 
              CanUserResizeRows="false" AutoGenerateColumns="false"
              HeadersVisibility="Column" IsReadOnly="True"
              EnableColumnVirtualization="true" EnableRowVirtualization="true"
              ScrollViewer.CanContentScroll="true"
              ScrollViewer.IsDeferredScrollingEnabled="true"
              VirtualizingPanel.IsVirtualizing="true"
              VirtualizingPanel.IsVirtualizingWhenGrouping="true"
              SelectionChanged="OnSelectionChangedGrid"
              VirtualizingPanel.VirtualizationMode="Recycling"
              FontFamily="{StaticResource JBMono}">
        <DataGrid.RowDetailsTemplate>
            <DataTemplate>
                <local:PositionGrid ItemsSource="{Binding Items, Mode=OneWay}"/>
            </DataTemplate>
        </DataGrid.RowDetailsTemplate>
        <DataGrid.Columns>
            <DataGridTextColumn Header="Регистрационный номер" Binding="{Binding RegId}"/>
            <DataGridTextColumn Header="Номер накопителя" Binding="{Binding StorageId}"/>
            <DataGridTextColumn Header="№" Binding="{Binding DocNumber}"/>
            <DataGridTextColumn Header="Смена" Binding="{Binding SessionId}"/>
            <DataGridTextColumn Header="№ в смене" Binding="{Binding DocInSession}"/>
            <DataGridTextColumn Header="Дата" Width="144"
                            Binding="{Binding Created, StringFormat={}{0:yyyy'-'MM'-'dd' 'HH':'mm':'ss}}"/>
            <DataGridTextColumn Header="ФПД" Width="65"
                            Binding="{Binding DocSign, StringFormat={}{0:R}}"/>
            <DataGridComboBoxColumn Header="Тип" SelectedValueBinding="{Binding Type}" Width="113"
                                ItemsSource="{x:Static utils:EnumLocales.ReceiptTypes}"
                                SelectedValuePath="Value" DisplayMemberPath="Locale"/>
            <DataGridComboBoxColumn Header="СНО" SelectedValueBinding="{Binding TaxationSystem}" Width="120"
                                ItemsSource="{x:Static utils:EnumLocales.TaxationSystems}"
                                SelectedValuePath="Value" DisplayMemberPath="Locale"/>
            <DataGridTextColumn Header="Покупатель" Binding="{Binding BuyerContact}">
                <DataGridTextColumn.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Style.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="Background" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGridTextColumn.CellStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Налично" Width="120"
                            Binding="{Binding CashSum, StringFormat={}{0} руб.}"/>
            <DataGridTextColumn Header="Безналично" Width="120"
                            Binding="{Binding NonCashSum, StringFormat={}{0} руб.}"/>
            <DataGridTextColumn Header="Аванс" Width="120"
                            Binding="{Binding AdvanceSum, StringFormat={}{0} руб.}"/>
            <DataGridTextColumn Header="Кредит" Width="120"
                            Binding="{Binding CreditSum, StringFormat={}{0} руб.}"/>
            <DataGridTextColumn Header="Иная оплата" Width="120"
                            Binding="{Binding ProvisionSum, StringFormat={}{0} руб.}"/>
            <DataGridTextColumn Header="Итог" Width="120"
                            Binding="{Binding TotalSum, StringFormat={}{0} руб.}"/>
        </DataGrid.Columns>
    </DataGrid>
</DockPanel>