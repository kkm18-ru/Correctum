<local:ImporterBase x:Class="RetailCorrector.Importers.AcquirerImporter"
                DataContext="{Binding RelativeSource={RelativeSource Self}}"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:s="clr-namespace:System;assembly=mscorlib"
                xmlns:control="clr-namespace:RetailCorrector.UI.Controls"
                xmlns:local="clr-namespace:RetailCorrector.Importers"
                xmlns:utils="clr-namespace:RetailCorrector.Utils"
                mc:Ignorable="d"
                d:DesignHeight="300" d:DesignWidth="300">
    <local:ImporterBase.Labels>
        <s:String>Путь к файлу</s:String>
        <s:String>Разделение</s:String>
        <s:String>Имеются заголовки?</s:String>
        <x:Null/>
        <s:String>Столбец операции</s:String>
        <s:String>Столбец даты</s:String>
        <s:String>Столбец итог</s:String>
        <s:String>Формат даты</s:String>
        <s:String>Наименование позиции</s:String>
        <s:String>НДС</s:String>
        <s:String>Паттерн прихода</s:String>
        <s:String>Паттерн возврата</s:String>
    </local:ImporterBase.Labels>
    <control:FilePathBox FileFilter="Операции по эквайрингу (*.csv)|*.csv"
                         FilePath="{Binding FilePath, Mode=TwoWay}"/>
    <ComboBox SelectedValue="{Binding Separator, Mode=TwoWay}">
        <ComboBox.Items>
            <s:Char>;</s:Char>
            <s:Char>,</s:Char>
        </ComboBox.Items>
    </ComboBox>
    <ComboBox SelectedValue="{Binding HasHeaders, Mode=TwoWay}">
        <ComboBox.Items>
            <s:Boolean>False</s:Boolean>
            <s:Boolean>True</s:Boolean>
        </ComboBox.Items>
    </ComboBox>
    <Button Content="Прочитать первую строку" Click="ReadFirstLine"/>
    <ComboBox ItemsSource="{Binding Headers, Mode=OneWay}"
              SelectedValue="{Binding OperationReceipt}"/>
    <ComboBox ItemsSource="{Binding Headers, Mode=OneWay}"
              SelectedValue="{Binding DateReceipt}"/>
    <ComboBox ItemsSource="{Binding Headers, Mode=OneWay}"
              SelectedValue="{Binding TotalReceipt}"/>
    <TextBox Text="{Binding DateFormat, Mode=TwoWay}"/>
    <TextBox Text="{Binding ItemName, Mode=TwoWay}"/>
    <ComboBox ItemsSource="{x:Static utils:EnumLocales.TaxRates}"
              DisplayMemberPath="Locale" SelectedValuePath="Value"
              SelectedValue="{Binding ItemVat, Mode=TwoWay}"/>
    <TextBox Text="{Binding IncomePattern, Mode=TwoWay}"/>
    <TextBox Text="{Binding RefundPattern, Mode=TwoWay}"/>
</local:ImporterBase>
