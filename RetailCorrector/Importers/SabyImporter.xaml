<local:ImporterBase x:Class="RetailCorrector.Importers.SabyImporter"
                    DataContext="{Binding RelativeSource={RelativeSource Self}}"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:control="clr-namespace:RetailCorrector.UI.Controls"
                    xmlns:local="clr-namespace:RetailCorrector.Importers"
                    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                    xmlns:utils="clr-namespace:RetailCorrector.Utils"
                    xmlns:valid="clr-namespace:RetailCorrector.Utils.ValidationRules"
                    xmlns:conv="clr-namespace:RetailCorrector.Converters"
                    mc:Ignorable="d"
                    d:DesignHeight="300" d:DesignWidth="300">
    <local:ImporterBase.Labels>
        <s:String>Логин</s:String>
        <s:String>Пароль</s:String>
        <x:Null/>
        <s:String>Начало сканирования</s:String>
        <s:String>Конец сканирования</s:String>
        <s:String>ИНН организации</s:String>
        <s:String>Регистрационный номер ККТ</s:String>
    </local:ImporterBase.Labels>
    <TextBox Text="{Binding Login}"/>
    <PasswordBox PasswordChanged="OnPasswordChanged"/>
    <Button Content="Авторизация" Click="Auth"
            IsEnabled="{Binding Authorizing, Mode=OneWay, Converter={x:Static conv:InvertBooleanConverter.Instance}}"/>
    <DatePicker DisplayDateStart="{x:Static utils:Constants.OfdBeginDate}" SelectedDateFormat="Short"
                SelectedDate="{Binding FromDate, Mode=TwoWay}"
                DisplayDateEnd="{Binding ToDate, Mode=OneWay}"/>
    <DatePicker DisplayDateEnd="{x:Static s:DateTime.Now}" SelectedDateFormat="Short"
                SelectedDate="{Binding ToDate, Mode=TwoWay}"
                DisplayDateStart="{Binding FromDate, Mode=OneWay}"/>
    <control:NotifyTextBox IsEnabled="{Binding Authorized, Mode=OneWay}"
                           Text="{utils:ValidatedBinding Inn, {x:Static valid:InnValidationRule.Instance}}"/>
    <xctk:CheckComboBox IsEditable="True" IsEnabled="{Binding Authorized, Mode=OneWay}"
                        SelectedItemsOverride="{Binding SelectedDevices, Mode=TwoWay}"
                        ItemsSource="{Binding Devices, Mode=OneWay}"/>
</local:ImporterBase>
