<local:ImporterBase x:Class="RetailCorrector.Importers.PlatformOfdImporter"
                DataContext="{Binding RelativeSource={RelativeSource Self}}"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:s="clr-namespace:System;assembly=mscorlib"
                xmlns:control="clr-namespace:RetailCorrector.UI.Controls"
                xmlns:conv="clr-namespace:RetailCorrector.Converters"
                xmlns:local="clr-namespace:RetailCorrector.Importers"
                xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                xmlns:utils="clr-namespace:RetailCorrector.Utils"
                mc:Ignorable="d"
                d:DesignHeight="300" d:DesignWidth="300">
    <local:ImporterBase.Labels>
        <s:String>Идентификатор сессии</s:String>
        <s:String>Токен доступа</s:String>
        <s:String>Токен обновления</s:String>
        <x:Null/>
        <s:String>ККТ</s:String>
        <s:String>Начало периода</s:String>
        <s:String>Конец периода</s:String>
    </local:ImporterBase.Labels>
    
    <TextBox Text="{Binding SessionId, Mode=TwoWay}"
             IsEnabled="{Binding Authorizing, Mode=OneWay,
                Converter={x:Static conv:InvertBooleanConverter.Instance}}"/>
    <PasswordBox PasswordChanged="OnAccessTokenChanged"
                 IsEnabled="{Binding Authorizing, Mode=OneWay,
                    Converter={x:Static conv:InvertBooleanConverter.Instance}}"/>
    <PasswordBox PasswordChanged="OnRefreshTokenChanged"
                 IsEnabled="{Binding Authorizing, Mode=OneWay, 
                    Converter={x:Static conv:InvertBooleanConverter.Instance}}"/>
    <Button Content="Авторизация" Click="Auth"
            IsEnabled="{Binding Authorizing, Mode=OneWay,
                Converter={x:Static conv:InvertBooleanConverter.Instance}}"/>
    <xctk:CheckComboBox IsEnabled="{Binding Authorized, Mode=OneWay}"
                        ItemsSource="{Binding Devices, Mode=OneWay}"
                        SelectedItemsOverride="{Binding SelectedDevices, Mode=OneWay}"/>
    <DatePicker SelectedDateFormat="Short" DisplayDateStart="{x:Static utils:Constants.OfdBeginDate}"
                IsEnabled="{Binding Authorized, Mode=OneWay}"
                SelectedDate="{Binding BeginDate, Mode=TwoWay}"
                DisplayDateEnd="{Binding EndDate, Mode=OneWay}"/>
    <DatePicker SelectedDateFormat="Short" DisplayDateEnd="{x:Static s:DateTime.Now}"
                IsEnabled="{Binding Authorized, Mode=OneWay}"
                SelectedDate="{Binding EndDate, Mode=TwoWay}"
                DisplayDateStart="{Binding BeginDate, Mode=OneWay}"/>
</local:ImporterBase>
