<local:ImporterBase x:Class="RetailCorrector.Importers.TaxcomImporter"
                    DataContext="{Binding RelativeSource={RelativeSource Self}}"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:RetailCorrector.Importers"
                    xmlns:conv="clr-namespace:RetailCorrector.Converters"
                    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
                    mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300">
    
    <local:ImporterBase.Labels>
        <s:String>Логин</s:String>
        <s:String>Пароль</s:String>
        <s:String>Номер договора</s:String>
        <x:Null/>
        <s:String>ККТ</s:String>
        <s:String>Начало периода</s:String>
        <s:String>Конец периода</s:String>
    </local:ImporterBase.Labels>
    
    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" 
             IsEnabled="{Binding Authorizing, Converter={x:Static conv:InvertBooleanConverter.Instance}, Mode=OneWay}"/>
    <PasswordBox PasswordChanged="OnPasswordChanged"
                 IsEnabled="{Binding Authorizing, Converter={x:Static conv:InvertBooleanConverter.Instance}, Mode=OneWay}"/>
    <TextBox Text="{Binding Agreement, UpdateSourceTrigger=PropertyChanged}"
             IsEnabled="{Binding Authorizing, Converter={x:Static conv:InvertBooleanConverter.Instance}, Mode=OneWay}"/>
    <Button Content="Авторизоваться" Click="Auth"
            IsEnabled="{Binding Authorizing, Converter={x:Static conv:InvertBooleanConverter.Instance}, Mode=OneWay}"/>
    <xctk:CheckComboBox ItemsSource="{Binding Devices, Mode=OneWay}"
                        SelectedItemsOverride="{Binding SelectedDevices}"
                        IsEnabled="{Binding Authorized, Mode=OneWay}"/>
    <DatePicker SelectedDate="{Binding BeginDate}" 
                IsEnabled="{Binding Authorized, Mode=OneWay}"/>
    <DatePicker SelectedDate="{Binding EndDate}" 
                IsEnabled="{Binding Authorized, Mode=OneWay}"/>
</local:ImporterBase>