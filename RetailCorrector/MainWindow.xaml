<Window x:Class="RetailCorrector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:RetailCorrector.Controls"
        xmlns:xcad="http://schemas.xceed.com/wpf/xaml/avalondock"
        Title="MainWindow" Height="500" Width="1000">
    <xcad:DockingManager AllowMixedOrientation="True">
        <xcad:DockingManager.DocumentHeaderTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" />
                </StackPanel>
            </DataTemplate>
        </xcad:DockingManager.DocumentHeaderTemplate>
        <xcad:LayoutRoot>
            <xcad:LayoutPanel Orientation="Horizontal">
                <xcad:LayoutDocumentPaneGroup>
                    <xcad:LayoutDocumentPane>
                        <xcad:LayoutDocument ContentId="receipts" Title="Чеки" CanClose="False">
                            <c:ReceiptGrid/>
                        </xcad:LayoutDocument>
                        <xcad:LayoutDocument ContentId="positions" Title="Позиции" CanClose="False">
                            <c:PositionGrid/>
                        </xcad:LayoutDocument>
                        <xcad:LayoutDocument ContentId="render" Title="Отображение" CanClose="False">
                            <Grid>
                                
                            </Grid>
                        </xcad:LayoutDocument>
                    </xcad:LayoutDocumentPane>
                </xcad:LayoutDocumentPaneGroup>
            </xcad:LayoutPanel>
        </xcad:LayoutRoot>
    </xcad:DockingManager>
</Window>
