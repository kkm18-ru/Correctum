<StackPanel x:Class="RetailCorrector.UI.Controls.DateRangePicker"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:uc="clr-namespace:RetailCorrector.UI.Controls"
            xmlns:u="clr-namespace:RetailCorrector.Utils"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:RetailCorrector.UI.Controls"
            Background="White" mc:Ignorable="d">
    <ToggleButton IsChecked="{Binding IsDropDownOpen}"
                  DataContext="{Binding RelativeSource={RelativeSource AncestorType=uc:DateRangePicker}}">
        <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="4"/>
            </Grid.ColumnDefinitions>
            <TextBlock d:Text="01.01.2016 - 31.12.2026" VerticalAlignment="Center"
                       HorizontalAlignment="Left" Margin="5,0,0,0"
                       Text="{Binding DisplayValue, Mode=OneWay}"/>
            <Polyline Points="5,0 10,6 15,0" Fill="#444444"
                      Grid.Column="1" VerticalAlignment="Center">
                <Polyline.RenderTransform>
                    <RotateTransform CenterX="10" CenterY="3" Angle="{Binding RotateOpenedIndicator, Mode=OneWay}" />
                </Polyline.RenderTransform>
            </Polyline>
        </Grid>
    </ToggleButton>
    <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=uc:DateRangePicker}}"
           Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
        <Viewbox SnapsToDevicePixels="True" Stretch="Fill">
            <Calendar SelectionMode="SingleRange" SelectedDatesChanged="SelectedDatesChanged"
                      DisplayDateStart="{x:Static u:DateRange.MinValueDateTime}"
                      DisplayDateEnd="{x:Static u:DateRange.MaxValueDateTime}"/>
        </Viewbox>
    </Popup>
</StackPanel>
