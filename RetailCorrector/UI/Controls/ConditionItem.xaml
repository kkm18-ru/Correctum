<ListBoxItem x:Class="RetailCorrector.UI.Controls.ConditionItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" d:DesignHeight="25" d:DesignWidth="300">
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <tk:WatermarkComboBox Grid.Column="0" ItemsSource="{Binding LocaleSubjects}" 
                              SelectedIndex="{Binding Subject}" Watermark="Субъект"/>
        <tk:WatermarkComboBox Grid.Column="2" ItemsSource="{Binding LocaleProps}" 
                              SelectedIndex="{Binding Prop}" Watermark="Реквизит"/>
    </Grid>
</ListBoxItem>
