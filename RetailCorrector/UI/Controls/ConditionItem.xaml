<ListBoxItem x:Class="RetailCorrector.UI.Controls.ConditionItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" d:DesignHeight="25" d:DesignWidth="300">
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <tk:WatermarkComboBox Grid.Column="0" ItemsSource="{Binding LocaleSubjects}" 
                              DisplayMemberPath="Locale" SelectedValuePath="Value" MinWidth="65" MaxWidth="125"
                              SelectedValue="{Binding Subject}" Watermark="Субъект"/>
        <tk:WatermarkComboBox Grid.Column="2" ItemsSource="{Binding LocaleProps}"  
                              DisplayMemberPath="Locale" SelectedValuePath="Value" MinWidth="50" MaxWidth="140"
                              SelectedValue="{Binding Prop}" Watermark="Реквизит"/>
        <tk:WatermarkComboBox Grid.Column="4" ItemsSource="{Binding LocaleOperators}" 
                              DisplayMemberPath="Locale" SelectedValuePath="Value" MinWidth="40" MaxWidth="240"
                              SelectedValue="{Binding Operator}" Watermark="Операция"/>
        <ContentControl Grid.Column="6" Content="{Binding ValueControl}" HorizontalContentAlignment="Stretch"/>
    </Grid>
</ListBoxItem>
