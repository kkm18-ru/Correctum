<w:DialogWindow x:Class="RetailCorrector.UI.Windows.ActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:RetailCorrector.UI.Windows.Types"
        xmlns:c="clr-namespace:RetailCorrector.UI.Controls"
        Title="Действие над чеками" Height="450" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        ResizeMode="NoResize">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="5"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <c:ConditionGrid Grid.Row="2" Grid.Column="0" SubjectType="{Binding SubjectType}"/>
    </Grid>
</w:DialogWindow>
