<wintypes:DialogWindow x:Class="RetailCorrector.UI.Windows.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:utils="clr-namespace:RetailCorrector.Utils"
        xmlns:conv="clr-namespace:RetailCorrector.Converters"
        xmlns:addons="clr-namespace:RetailCorrector.Utils.Integrations"
        xmlns:wintypes="clr-namespace:RetailCorrector.UI.Windows.Types"
        xmlns:nlog="clr-namespace:NLog;assembly=NLog"
        DataContext="{Binding Source={x:Static utils:Configuration.Instance}}"
        Title="Настройки" Height="300" Width="450">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <ObjectDataProvider x:Key="GetEoUPorts" ObjectType="{x:Type addons:EoU}" MethodName="GetAvailablePorts" />
        <conv:MultiBooleanConverter x:Key="convMultiBoolean"/>
    </Window.Resources>
    <TabControl>
        <TabItem Header="Atol-драйвер">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Кол-во чеков до передачи в ОФД:"/>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="Время ожидания отправки чеков:"/>
                <TextBlock Grid.Column="0" Grid.Row="4" Text="Транспортный порт Atol (EoU):"/>
                
                <tk:IntegerUpDown Grid.Column="2" Grid.Row="0" Minimum="10" Maximum="5000" Increment="10"
                                  Value="{Binding Fptr.CountReceiptsBeforeDelay}"/>
                <tk:IntegerUpDown Grid.Column="2" Grid.Row="2" Minimum="10" Maximum="60"
                                  Value="{Binding Fptr.Delay}"/>
                <ComboBox Grid.Column="2" Grid.Row="4" 
                          IsEnabled="{Binding Items.Count, RelativeSource={RelativeSource Self}}"
                          ItemsSource="{Binding Source={StaticResource GetEoUPorts}}"
                          SelectedValue="{Binding PortEoU, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </TabItem>
        <TabItem Header="HTTP">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Количество документов в ответе:"/>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="Интервал между HTTP-запросами:"/>
                <TextBlock Grid.Column="0" Grid.Row="4" Text="Количество попыток запроса:"/>
                <TextBlock Grid.Column="0" Grid.Row="6" Text="Путь к Chromium-браузеру:"/>
                
                <tk:IntegerUpDown Grid.Column="2" Grid.Row="0" Minimum="1" Grid.ColumnSpan="3"
                                  Value="{Binding HttpClient.PageSize}"/>
                <tk:IntegerUpDown Grid.Column="2" Grid.Row="2" Minimum="1" Grid.ColumnSpan="3"
                                  Value="{Binding HttpClient.RequestDelay}"/>
                <tk:IntegerUpDown Grid.Column="2" Grid.Row="4" Minimum="1" Grid.ColumnSpan="3"
                                  Value="{Binding HttpClient.TriesCount}"/>
                <TextBox Grid.Column="2" Grid.Row="6" Text="{Binding HttpClient.HeadlessBrowserPath}"/>
                <Button Grid.Column="4" Grid.Row="6" Content="..." Click="OnBrowserPathSelector"/>
            </Grid>
        </TabItem>
        <TabItem Header="Экспорт">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Количество документов в скрипте:"/>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="Количество документов в SQL-запросе:"/>
                
                <tk:IntegerUpDown Grid.Column="2" Grid.Row="0" Minimum="1" Maximum="150"
                                  Value="{Binding Exporters.Fptr.DocsPerFile}"/>
                <tk:IntegerUpDown Grid.Column="2" Grid.Row="2" Minimum="1"
                                  Value="{Binding Sqlite.Limit}"/>
            </Grid>
        </TabItem>
        <TabItem Header="Импорт">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Column="0" Grid.Row="0" Text="ID интегратора Taxcom:"/>
                
                <TextBox Grid.Column="2" Grid.Row="0" 
                         Text="{Binding Importers.TaxcomIntegratorId, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </TabItem>
        <TabItem Header="Логирование">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <CheckBox Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="3" Content="Передавать логи в центрилизированое хранилище Loki?"
                          IsChecked="{Binding Logging.LokiEnabled}"/>
                <CheckBox Grid.Column="0" Grid.Row="10" Grid.ColumnSpan="3" Content="Loki-сервер использует Basic-авторизацию?"
                          IsEnabled="{Binding Logging.LokiEnabled}"
                          IsChecked="{Binding Logging.LokiAuthEnabled}"/>
                
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Путь к журнал-файлу:"/>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="Минимальный уровень логирования:"/>
                <TextBlock Grid.Column="0" Grid.Row="6" Text="Адрес Loki-сервера:"/>
                <TextBlock Grid.Column="0" Grid.Row="8" Text="Идентификатор устройства в Loki:"/>
                <TextBlock Grid.Column="0" Grid.Row="12" Text="Логин:"/>
                <TextBlock Grid.Column="0" Grid.Row="14" Text="Пароль:"/>
                
                <TextBox Grid.Column="2" Grid.Row="0" 
                         Text="{Binding Logging.FilePath, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Grid.Column="2" Grid.Row="2" SelectedValuePath="Ordinal" DisplayMemberPath="Name"
                         ItemsSource="{Binding Source={x:Static nlog:LogLevel.AllLoggingLevels}}"
                         SelectedValue="{Binding Logging.MinLevel}"/>
                <TextBox Grid.Column="2" Grid.Row="6" 
                         IsEnabled="{Binding Logging.LokiEnabled}"
                         Text="{Binding Logging.LokiEndpoint, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="2" Grid.Row="8" 
                         IsEnabled="{Binding Logging.LokiEnabled}"
                         Text="{Binding Logging.LokiHostName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="2" Grid.Row="12" 
                         Text="{Binding Logging.LokiUsername, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.IsEnabled>
                        <MultiBinding Converter="{StaticResource convMultiBoolean}">
                            <Binding Path="Logging.LokiEnabled"/>
                            <Binding Path="Logging.LokiAuthEnabled"/>
                        </MultiBinding>
                    </TextBox.IsEnabled>
                </TextBox>
                <PasswordBox Grid.Column="2" Grid.Row="14" Loaded="OnLokiPasswordLoaded" PasswordChanged="OnLokiPasswordChanged">
                    <PasswordBox.IsEnabled>
                        <MultiBinding Converter="{StaticResource convMultiBoolean}">
                            <Binding Path="Logging.LokiEnabled"/>
                            <Binding Path="Logging.LokiAuthEnabled"/>
                        </MultiBinding>
                    </PasswordBox.IsEnabled>
                </PasswordBox>
            </Grid>
        </TabItem>
    </TabControl>
</wintypes:DialogWindow>
