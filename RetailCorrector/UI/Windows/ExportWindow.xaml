<type:DialogWindow x:Class="RetailCorrector.UI.Windows.ExportWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:type="clr-namespace:RetailCorrector.UI.Windows.Types"
                   DataContext="{Binding RelativeSource={RelativeSource Self}}"
                   SizeToContent="WidthAndHeight" Title="Экспорт чеков">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="155"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="7.5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Button Grid.Column="0" Grid.Row="0" Content="Сохранить" Click="Export"/>
        
        <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center"
                   Text="Путь:"/>
        <TextBox Grid.Column="2" Grid.Row="2" VerticalContentAlignment="Center"
                 Text="{Binding Path}"/>
        <Button Grid.Column="4" Grid.Row="2" Content="..." Height="20" Click="BrowsePath"/>
    </Grid>
</type:DialogWindow>