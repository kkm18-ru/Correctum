<DataGrid x:Class="Correctum.Views.Controls.PositionGrid"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:Correctum.Views.Controls"
          xmlns:m="clr-namespace:Correctum.Models"
          mc:Ignorable="d" Style="{StaticResource PositionDataGrid}"
          d:DataContext="{d:DesignInstance Type={x:Type m:PositionView}, IsDesignTimeCreatable=True}"
          d:DesignHeight="450" d:DesignWidth="800">
    <DataGrid.Columns>
        <DataGridTemplateColumn Header="Наименование" >
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <StackPanel Background="{Binding Name, Converter={StaticResource nullIndicator}, Mode=OneWay}">
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Foreground="Black" />
                    </StackPanel>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Предмет расчета" >
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <StackPanel Background="{Binding SubjectType, Converter={StaticResource nullIndicator}, Mode=OneWay}">
                        <TextBlock Text="{Binding SubjectType}" HorizontalAlignment="Center" Foreground="Black" />
                    </StackPanel>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Способ расчета" >
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <StackPanel Background="{Binding CalcMethod, Converter={StaticResource nullIndicator}, Mode=OneWay}">
                        <TextBlock Text="{Binding CalcMethod}" HorizontalAlignment="Center" Foreground="Black" />
                    </StackPanel>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Ставка НДС" >
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <StackPanel Background="{Binding NDS, Converter={StaticResource nullIndicator}, Mode=OneWay}">
                        <TextBlock Text="{Binding NDS}" HorizontalAlignment="Center" Foreground="Black" />
                    </StackPanel>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Мера измерения" >
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <StackPanel Background="{Binding UnitOfMeasure, Converter={StaticResource nullIndicator}, Mode=OneWay}">
                        <TextBlock Text="{Binding UnitOfMeasure}" HorizontalAlignment="Center" Foreground="Black" />
                    </StackPanel>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Цена" >
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <StackPanel Background="{Binding Price, Converter={StaticResource nullIndicator}, Mode=OneWay}">
                        <TextBlock Text="{Binding Price}" HorizontalAlignment="Center" Foreground="Black" />
                    </StackPanel>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Количество" >
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <StackPanel Background="{Binding Quantity, Converter={StaticResource nullIndicator}, Mode=OneWay}">
                        <TextBlock Text="{Binding Quantity}" HorizontalAlignment="Center" Foreground="Black" />
                    </StackPanel>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Стоимость">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <StackPanel Background="{Binding Cost, Converter={StaticResource nullIndicator}, Mode=OneWay}">
                        <TextBlock Text="{Binding Cost}" HorizontalAlignment="Center" Foreground="Black"/>
                    </StackPanel>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
    </DataGrid.Columns>
</DataGrid>
