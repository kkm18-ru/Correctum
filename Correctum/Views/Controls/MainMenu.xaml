<Menu x:Class="Correctum.Views.Controls.MainMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:Correctum.ViewModels.Controls"
      xmlns:u="clr-namespace:Correctum.Utils"
      xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
      mc:Ignorable="d" d:DesignHeight="20" d:DesignWidth="1000">
    <Menu.DataContext>
        <vm:MainMenuViewModel/>
    </Menu.DataContext>
    <MenuItem Header="Файл">
        <MenuItem Header="Создать" Command="{Binding CreateContextCommand}"
                  Icon="{icons:MaterialIconExt Kind=FileOutline, IconSize=16}" />
        <MenuItem Header="Открыть" Command="{Binding LoadContextCommand}"
                  Icon="{icons:MaterialIconExt Kind=FolderOutline, IconSize=16}" />
        <MenuItem Header="Сохранить как..." Command="{Binding SaveAsContextCommand}"
                  Icon="{icons:MaterialIconExt Kind=ContentSaveOutline, IconSize=16}" />
        <Separator/>
        <MenuItem Header="Импорт" ItemsSource="{Binding Imports, Mode=OneTime}"
                  Icon="{icons:MaterialIconExt Kind=DatabaseImport, IconSize=16}" >
            <MenuItem.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="Header" Value="{Binding DisplayName}" />
                    <Setter Property="Command" Value="{Binding DataContext.OpenImportCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                    <Setter Property="CommandParameter" Value="{Binding}"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </MenuItem.ItemContainerStyle>
        </MenuItem>
        <MenuItem Header="Экспорт..." ItemsSource="{Binding Exporters}" 
                  Icon="{icons:MaterialIconExt Kind=DatabaseExport, IconSize=16}" />
        <MenuItem Header="Вставить" Command="{Binding ShowPasteCommand}" InputGestureText="Ctrl + V" 
                  Icon="{icons:MaterialIconExt Kind=ContentPaste, IconSize=16}" />
        <Separator/>
        <MenuItem Header="Провести чеки" Command="{Binding ShowFptrCommand}"
                  Icon="{icons:MaterialIconExt Kind=ReceiptTextSendOutline, IconSize=16}" />
        <Separator/>
        <MenuItem Header="Настройки" Command="{Binding ShowSettingsCommand}"
                  Icon="{icons:MaterialIconExt Kind=CogOutline, IconSize=16}" />
        <MenuItem Header="Выход" Command="{Binding QuitCommand}"
                  Icon="{icons:MaterialIconExt Kind=ExitToApp, IconSize=16}" />
    </MenuItem>
    <MenuItem Header="Действия" ItemsSource="{Binding Actions, Mode=OneTime}">
        <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding DisplayName}" />
                <Setter Property="Command" Value="{Binding DataContext.OpenActionCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                <Setter Property="CommandParameter" Value="{Binding}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
        </MenuItem.ItemContainerStyle>
    </MenuItem>
    <MenuItem Header="Отчеты" ItemsSource="{Binding Reports, Mode=OneTime}">
        <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding DisplayName}" />
                <Setter Property="Command" Value="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                <Setter Property="CommandParameter" Value="{Binding}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
        </MenuItem.ItemContainerStyle>
    </MenuItem>
    <MenuItem Header="Помощь">
        <MenuItem Header="Список изменений" Command="{Binding OpenLinkCommand}"
                  Icon="{icons:MaterialIconExt Kind=TimelineTextOutline, IconSize=16}"  
                  CommandParameter="https://github.com/kkm18-ru/Correctum/blob/HEAD/CHANGELOG.md" />
        <MenuItem Header="Обратная связь" Command="{Binding OpenLinkCommand}"
                  Icon="{icons:MaterialIconExt Kind=MessageAlertOutline, IconSize=16}"                   
                  CommandParameter="https://forms.yandex.ru/u/6a0fe98d95add5af2bdbc9ae" />
    </MenuItem>
</Menu>
