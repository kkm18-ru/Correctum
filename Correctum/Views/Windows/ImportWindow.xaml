<wt:DialogWindow x:Class="Correctum.Views.Windows.ImportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:wt="clr-namespace:Correctum.UI.Windows.Types"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:cc="clr-namespace:Correctum.UI.Controls"
                 xmlns:local="clr-namespace:Correctum.Views.Windows"
                 xmlns:vm="clr-namespace:Correctum.ViewModels.Windows"
                 SizeToContent="WidthAndHeight" mc:Ignorable="d" MaxWidth="361"
                 d:DataContext="{d:DesignInstance Type={x:Type vm:ImportWindowViewModel}, IsDesignTimeCreatable=True}"
                 Title="{Binding ImportName, StringFormat={}Импорт из {0}}">
    <StackPanel Margin="5">
        <ContentControl Content="{Binding Import}"/>
        <WrapPanel>
            <cc:TextProgressBar Width="125" Value="{Binding CurrentProgress}"
                                Maximum="{Binding MaximumProgress}"/>
            <Separator Width="5" Background="{x:Null}"/>
            <Button Width="100" Content="Запустить" Command="{Binding StartCommand}"/>
            <Separator Width="5" Background="{x:Null}"/>
            <Button Width="100" Content="Отмена" Command="{Binding CancelCommand}"/>
        </WrapPanel>
    </StackPanel>
</wt:DialogWindow>
