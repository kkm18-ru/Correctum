<wt:DialogWindow x:Class="Correctum.Views.Windows.PasteWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:wt="clr-namespace:Correctum.UI.Windows.Types"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:Correctum.ViewModels.Windows"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:Correctum.Views.Windows"                 
                 d:DataContext="{d:DesignInstance Type={x:Type vm:PasteWindowViewModel}, IsDesignTimeCreatable=True}"
                 mc:Ignorable="d" Title="Вставить чек" Height="550" Width="400">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="21"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="85"/>
        </Grid.ColumnDefinitions>

        <ComboBox 
            ItemsSource="{Binding Deserializers, Mode=OneTime}" 
            SelectedItem="{Binding CurrentDeserializer}"
            DisplayMemberPath="DisplayName" />

        <Button Grid.Column="2" Content="Добавить" Command="{Binding PasteCommand}"/>

        <TextBox Grid.Row="2" Grid.ColumnSpan="3" AcceptsReturn="True" AcceptsTab="True"
                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</wt:DialogWindow>
