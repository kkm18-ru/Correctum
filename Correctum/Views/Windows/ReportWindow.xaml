<wintypes:DialogWindow x:Class="Correctum.Views.Windows.ReportWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:wintypes="clr-namespace:Correctum.UI.Windows.Types"
                       xmlns:sys="clr-namespace:System;assembly=mscorlib"
                       xmlns:conv="clr-namespace:Correctum.Converters"
                       xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                       xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
                       xmlns:vm="clr-namespace:Correctum.ViewModels.Windows"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       mc:Ignorable="d" 
                       d:DataContext="{d:DesignInstance Type={x:Type vm:ReportWindowViewModel}, IsDesignTimeCreatable=True}"
                       xmlns:local="clr-namespace:Correctum.UI.Windows"
                       Title="{Binding ReportName, Mode=OneTime, StringFormat='Отчет &quot;{0}&quot;'}"
                       Height="450" Width="700">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="70"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="23"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <ProgressBar Grid.Column="0" Grid.Row="0" Value="0" Maximum="1"
                     IsIndeterminate="{Binding IsBusy, Mode=OneWay}" />
        <Button Grid.Column="4" Grid.Row="0" Content="Экспорт..."
                Command="{Binding ExportCommand}"/>
        
        <DataGrid Grid.ColumnSpan="5" Grid.Row="2" IsReadOnly="True"
                  AutoGenerateColumns="True" CanUserAddRows="False"
                  CanUserDeleteRows="False" ItemsSource="{Binding Table}"
                  HeadersVisibility="Column" CanUserResizeColumns="False"
                  CanUserResizeRows="False" CanUserReorderColumns="False"
                  CanUserSortColumns="False">
        </DataGrid>
    </Grid>
</wintypes:DialogWindow>
