<wintypes:DialogWindow x:Class="Correctum.Views.Windows.ReportWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:wintypes="clr-namespace:Correctum.UI.Windows.Types"
                       xmlns:sys="clr-namespace:System;assembly=mscorlib"
                       xmlns:conv="clr-namespace:Correctum.Converters"
                       xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                       xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
                       xmlns:vm="clr-namespace:Correctum.ViewModels.Windows"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:oxy="http://oxyplot.org/wpf"
                       mc:Ignorable="d" 
                       d:DataContext="{d:DesignInstance Type={x:Type vm:ReportWindowViewModel}, IsDesignTimeCreatable=True}"
                       xmlns:local="clr-namespace:Correctum.UI.Windows"
                       Title="{Binding ReportName, Mode=OneTime, StringFormat='Отчет &quot;{0}&quot;'}"
                       SizeToContent="WidthAndHeight" >
    <StackPanel Margin="10" Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" IsIndeterminate="{Binding Exporting, Mode=OneWay}" />
            <Button Grid.Column="2" Content="Экспорт..." Command="{Binding ExportCommand}"/>
        </Grid>        
        <Separator Height="5"/>
        <oxy:PlotView Height="220" Model="{Binding Plot}" MinWidth="500"
                      Visibility="{Binding Plot, Converter={StaticResource collapsedWhenNullConverter}}" />
        <Separator Height="5" Visibility="{Binding Plot, Converter={StaticResource collapsedWhenNullConverter}}"/>
        <DataGrid IsReadOnly="True" AutoGenerateColumns="True"
                  CanUserAddRows="False" CanUserSortColumns="False"
                  CanUserDeleteRows="False" ItemsSource="{Binding Table}"
                  HeadersVisibility="Column" CanUserResizeColumns="False"
                  CanUserResizeRows="False" CanUserReorderColumns="False" />
    </StackPanel>
</wintypes:DialogWindow>
