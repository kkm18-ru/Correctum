<Window x:Class="Correctum.Views.Windows.ExchangeOfdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:vm="clr-namespace:Correctum.ViewModels.Windows"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Title="Передача документов в ОФД"
        
        d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type=vm:ExchangeOfdWindowViewModel}"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <StackPanel Margin="25, 10">
        <TextBlock Text="{Binding InitializeUnsentCount, Mode=OneTime, StringFormat={}Отправка {0} ФД в ОФД}"/>
        <TextBlock Text="{Binding CurrentProgress, Mode=OneWay, StringFormat={}{0:0.00}% завершено}" FontSize="16"/>
        <ProgressBar Value="{Binding CurrentProgress, Mode=OneWay}" Maximum="100" Width="395"/>
        <TextBlock Text="{Binding FirstUnsentDocument, Mode=OneWay, StringFormat={}Первый неотправленный ФД: №{0}}"/>
        <TextBlock Text="{Binding RemainingTime, Mode=OneWay, StringFormat={}Оставшееся время: {0:hh':'mm':'ss}}"/>
        <TextBlock Text="{Binding RemainingCount, Mode=OneWay, StringFormat={}Оставшееся количество: {0}}"/>
    </StackPanel>
</Window>
