<Window x:Class="Correctum.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Correctum.Views.Windows"
        xmlns:vm="clr-namespace:Correctum.ViewModels.Windows"
        xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:c="clr-namespace:Correctum.Views.Controls"
        xmlns:u="clr-namespace:Correctum.Utils"
        mc:Ignorable="d"
        Title="Correctum" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteRawReceiptCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <c:MainMenu DockPanel.Dock="Top"/>
        <WrapPanel DockPanel.Dock="Top" Margin="5" ItemHeight="22">
            <Button Content="🗘" Width="22" Command="{Binding RefreshCommand}"/>
            <Separator Width="5"/>
            <Button Content="&lt;&lt;" Width="22" Command="{Binding GoToFirstPageCommand}"/>
            <Separator Width="5"/>
            <Button Content="&lt;" Width="22" Command="{Binding GoToPreviousPageCommand}"/>
            <Separator Width="5"/>
            <tk:IntegerUpDown ShowButtonSpinner="False" Width="55" 
                              HorizontalContentAlignment="Center"
                              Value="{Binding PageNumber}"/>
            <Separator Width="5"/>
            <Button Content="&gt;" Width="22" Command="{Binding GoToNextPageCommand}"/>
            <Separator Width="5"/>
            <Button Content="&gt;&gt;" Width="22" Command="{Binding GoToLastPageCommand}"/>
        </WrapPanel>
        <c:ReceiptGrid ItemsSource="{Binding ReceiptPage}" />
    </DockPanel>
</Window>
