<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<GenerateDocumentationFile>False</GenerateDocumentationFile>
		<PublishAot>true</PublishAot>
		<AssemblyName>Correctum</AssemblyName>
		<ApplicationIcon>Assets\logo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
	  <AvaloniaXaml Remove="Views\Controls\**" />
	  <Compile Remove="Views\Controls\**" />
	  <EmbeddedResource Remove="Views\Controls\**" />
	  <None Remove="Views\Controls\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.11" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
		<!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
		<PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
		<PackageReference Include="Irihi.Ursa" Version="1.15.0" />
		<PackageReference Include="Irihi.Ursa.Themes.Semi" Version="1.15.0" />
		<PackageReference Include="MessageBox.Avalonia" Version="3.3.1.1" />
		<PackageReference Include="Semi.Avalonia" Version="11.3.7.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Correctum.Application\Correctum.Application.csproj" />
		<ProjectReference Include="..\Correctum.Infrastructure\Correctum.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Views\Importers\PlatformImporter.axaml.cs">
	    <DependentUpon>PlatformImporter.axaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\Importers\TaxcomImporter.axaml.cs">
	    <DependentUpon>TaxcomImporter.axaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\Importers\SabyImporter.axaml.cs">
	    <DependentUpon>SabyImporter.axaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\Importers\OfdRuImporter.axaml.cs">
	    <DependentUpon>OfdRuImporter.axaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\Importers\OfdRuTokenImporter.axaml.cs">
	    <DependentUpon>OfdRuTokenImporter.axaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\Windows\ReceiptDeserializatorWindow.axaml.cs">
	    <DependentUpon>ReceiptDeserializatorWindow.axaml</DependentUpon>
	  </Compile>
	</ItemGroup>
</Project>
