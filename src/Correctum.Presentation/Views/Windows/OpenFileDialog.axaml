<l:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:dialogs="using:Avalonia.Dialogs"
        xmlns:l="using:Correctum.Views.Windows"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmw="using:Correctum.ViewModels.Windows"
        x:Class="Correctum.Views.Windows.OpenFileDialog"
        x:DataType="vmw:OpenFileDialogViewModel">
    <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="5"
          ColumnDefinitions="Auto, *, Auto" ColumnSpacing="5"
          Margin="10">
        <TextBox Grid.ColumnSpan="3" Text="{Binding DirectoryPath}"/>

        <ListBox ItemsSource="{Binding Items, Mode=OneWay}"
                 FontFamily="JetBrainsMono"
                 Grid.ColumnSpan="3" Grid.Column="0" Grid.Row="1"/>

        <TextBlock Grid.Column="0" Grid.Row="2" Text="Путь к файлу"/>
        <TextBlock Grid.Column="0" Grid.Row="3" Text="Тип файла"/>

		<TextBox Text="{Binding FileName}"
                 Grid.Column="1" Grid.Row="2"/>
		<ComboBox ItemsSource="{Binding FileTypes, Mode=OneTime}"
                  SelectedIndex="{Binding FileTypeIndex}"
                  Grid.Column="1" Grid.Row="3"
                  HorizontalAlignment="Stretch"/>

        <Button Grid.Column="2" Grid.Row="2" Content="Открыть"
                HorizontalAlignment="Stretch" Click="OpenFile"
                IsEnabled="{Binding IsValidFileName, Mode=OneWay}"/>
        <Button Grid.Column="2" Grid.Row="3" Content="Отмена"
                HorizontalAlignment="Stretch" Click="Cancel"/>
    </Grid>
</l:DialogWindow>
