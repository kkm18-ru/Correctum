<WrapPanel x:Class="Correctum.Views.Actions.SettingCalculationMethodView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
           d:DataContext="{d:DesignInstance Type={x:Type a:SetCalculationMethodReceiptAction}, IsDesignTimeCreatable=True}"
           xmlns:u="clr-namespace:Correctum.Utils"
           xmlns:a="clr-namespace:Correctum.Actions" mc:Ignorable="d" >
    <TextBlock Text="Заменить " VerticalAlignment="Center" />
    <tk:CheckComboBox SelectedItemsOverride="{Binding Filter}"
                      ItemsSource="{Binding Nullable, Source={x:Static u:EnumLocales.PositionPayments}}" 
                      DisplayMemberPath="Locale" ValueMemberPath="Value"/>
    <TextBlock Text=" на " VerticalAlignment="Center" />
    <ComboBox SelectedValue="{Binding Value}" 
              ItemsSource="{x:Static u:EnumLocales.PositionPayments}" 
              DisplayMemberPath="Locale" SelectedValuePath="Value"/>
</WrapPanel>
