<wintypes:DialogWindow x:Class="Correctum.UI.Windows.FptrWindow"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:s="clr-namespace:System;assembly=mscorlib"
          xmlns:controls="clr-namespace:Correctum.UI.Controls"
          xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
          xmlns:wintypes="clr-namespace:Correctum.UI.Windows.Types"
          xmlns:converts="clr-namespace:Correctum.Converters"
          xmlns:rc="clr-namespace:Correctum"
          DataContext="{Binding RelativeSource={RelativeSource Self}}"
          SizeToContent="WidthAndHeight" Title="Проведение чеков">
    <Grid Margin="5">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
            <Button IsEnabled="{Binding CanConfigDriver, Mode=OneWay}" Width="142"
                    Content="Настройка драйвера" Click="ShowSettingsDriver" Margin="0,0,2.5,0" />
            <Button Content="{Binding ConnectionButtonText, Mode=OneWay}"
                    Click="SwitchConnection" Margin="2.5,0,0,0" Width="108" 
                    IsEnabled="{Binding CanDisconnected, Mode=OneWay}"/>
        </StackPanel>
        
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Вид коррекции:"/>
        <ComboBox Grid.Row="2" Grid.Column="2" 
                  IsEnabled="{Binding CanSettings, Mode=OneWay}"
                  SelectedIndex="{Binding CorrectionType}">
            <ComboBox.Items>
                <s:String>Самостоятельная</s:String>
                <s:String>По предписанию</s:String>
            </ComboBox.Items>
        </ComboBox>
        
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Номер акта:"/>
        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Act}"
                 IsEnabled="{Binding CanSettings, Mode=OneWay}"/>
        
        <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                  IsChecked="{Binding IsInternet}"
                  Content="Применить рассчет для сети ''Интернет''"
                  IsEnabled="{Binding CanSettings, Mode=OneWay}"/>
        
        <controls:TextProgressBar 
            Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" 
            Value="{Binding CurrentIndex, Mode=OneWay}"
            Maximum="{Binding Source={x:Static rc:StorageContext.ReceiptsCount}, Mode=OneTime}"/>
        
        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
            <Button Content="{Binding RunButtonText, Mode=OneWay}" 
                    Click="UpdateState" Margin="0,0,2.5,0" Width="52"
                    IsEnabled="{Binding CanRun, Mode=OneWay}"/>
            <Button Content="Тест" Margin="2.5,0,2.5,0" Width="38" Click="Test"
                    IsEnabled="{Binding CanSettings, Mode=OneWay}"/>
        </StackPanel>
        
    </Grid>
</wintypes:DialogWindow>
