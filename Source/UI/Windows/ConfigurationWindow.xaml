<wintypes:DialogWindow x:Class="Correctum.UI.Windows.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:utils="clr-namespace:Correctum.Utils"
        xmlns:conv="clr-namespace:Correctum.Converters"
        xmlns:addons="clr-namespace:Correctum.Utils.Integrations"
        xmlns:wintypes="clr-namespace:Correctum.UI.Windows.Types"
        xmlns:nlog="clr-namespace:NLog;assembly=NLog"
        DataContext="{Binding Source={x:Static utils:Configuration.Current}}"
        Title="Настройки" SizeToContent="WidthAndHeight">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style TargetType="UniformGrid">
            <Setter Property="Columns" Value="2"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate DataType="TextBlock">
                        <TextBlock FontWeight="Bold" Text="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <WrapPanel Margin="5">
        <StackPanel>
            <GroupBox Header="Локальное логирование">
                <StackPanel>
                    <TextBlock Text="Мин. уровень логирования:"/>
                    <ComboBox SelectedValuePath="Ordinal" DisplayMemberPath="Name"
                              ItemsSource="{Binding Source={x:Static nlog:LogLevel.AllLoggingLevels}}"
                              SelectedValue="{Binding Logging.Local.MinLevel}"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Централизованное логирование">
                <StackPanel>
                    <TextBlock Text="Мин. уровень логирования:"/>
                    <ComboBox SelectedValuePath="Ordinal" DisplayMemberPath="Name"
                              ItemsSource="{Binding Source={x:Static nlog:LogLevel.AllLevels}}"
                              SelectedValue="{Binding Logging.Seq.MinLevel}"/>

                    <TextBlock Text="Адрес сервера:"/>
                    <TextBox Text="{Binding Logging.Seq.Endpoint}"/>

                    <TextBlock Text="Ключ доступа:"/>
                    <PasswordBox PasswordChar="*" 
                                 PasswordChanged="PasswordBox_PasswordChanged" 
                                 Loaded="PasswordBox_Loaded"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <StackPanel>
            <GroupBox Header="Такском">
                <StackPanel>
                    <TextBlock Text="ID интегратора:"/>
                    <TextBox Text="{Binding Import.Taxcom.IntegratorId, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="HTTP-запросы">
                <StackPanel>
                    <TextBlock Text="Количество документов в ответе:"/>
                    <tk:IntegerUpDown Minimum="1" Value="{Binding Http.PageSize}"/>

                    <TextBlock Text="Интервал между HTTP-запросами:"/>
                    <tk:IntegerUpDown Minimum="1" Value="{Binding Http.RequestDelay}"/>

                    <TextBlock Text="Количество попыток запроса:"/>
                    <tk:IntegerUpDown Minimum="1" Value="{Binding Http.TriesCount}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <StackPanel>
            <GroupBox Header="Формирование ЧК">
                <StackPanel>
                    <TextBlock Text="Кол-во чеков до передачи в ОФД:"/>
                    <tk:IntegerUpDown Minimum="10" Maximum="5000" Increment="10" Value="{Binding Fptr.SizeStack}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </WrapPanel>
</wintypes:DialogWindow>
