<Application x:Class="Correctum.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:rd="clr-namespace:Correctum.ResourceDictionaries"
             xmlns:w="clr-namespace:Correctum.Windows"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views\Windows\MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ResourceDictionaries/Converters.xaml"/>
                <ResourceDictionary Source="/ResourceDictionaries/Fonts.xaml"/>
                <ResourceDictionary Source="/ResourceDictionaries/Style.xaml"/>
                <rd:ModuleViews/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type w:FiscalExchangeStatusWindow}">
                <Setter Property="WindowStyle" Value="None" />
                <Setter Property="SizeToContent" Value="WidthAndHeight" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate DataType="{x:Type w:FiscalExchangeStatusWindow}">
                            <StackPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type w:FiscalExchangeStatusWindow}}}" Margin="26, 18">
                                <TextBlock Text="{Binding InitialUnsentDocumentCount, StringFormat={} Отправка {0} ФД из буфера неотправленных чеков в ОФД}"/>
                                <TextBlock Text="{Binding Percent, StringFormat={} {0:F0}% завершено}" FontSize="18" />
                                <ProgressBar Value="{Binding SentDocumentCount, Mode=OneWay}"  Margin="0,10"
                                 Maximum="{Binding InitialUnsentDocumentCount, Mode=OneTime}" Height="80"/>
                                <TextBlock Text="{Binding Speed, StringFormat={} Скорость передачи: {0:F0} ФД/с}" />
                                <TextBlock Text="{Binding RemainingSeconds, StringFormat={} Время ожидания: {0:F0} сек. }" />
                                <TextBlock Text="{Binding CurrentUnsentDocumentCount, StringFormat={} Осталось документов: {0}}" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type w:QueryWindow}">
                <Setter Property="SizeToContent" Value="WidthAndHeight" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate DataType="{x:Type w:QueryWindow}">
                            <StackPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type w:QueryWindow}}}" 
                                        Margin="10" Width="350">
                                <DockPanel Margin="0,0,0,5">
                                    <Button Content="➤" Command="{Binding QueryCommand}" Width="22" 
                                            Height="22" Margin="5,0,0,0" DockPanel.Dock="Right" />
                                    <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" AcceptsTab="True"/>
                                </DockPanel>
                                <TextBlock Text="{Binding StatusText}" Margin="0,0,0,5" TextWrapping="WrapWithOverflow"
                                           Visibility="{Binding StatusText, Converter={StaticResource collapsedWhenNullConverter}}" />
                                <DataGrid ItemsSource="{Binding Result.DefaultView}" IsReadOnly="True" AutoGenerateColumns="True"
                                          Visibility="{Binding Result, Converter={StaticResource collapsedWhenNullConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
